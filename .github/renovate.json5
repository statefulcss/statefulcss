{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
	timezone: "Europe/Berlin",
	schedule: ["before 6am on monday"],
	labels: ["dependencies"],

	// PR titles become squash commit messages, so they must pass commitlint (allowed scopes: repo, web, ...).
	semanticCommits: "enabled",
	semanticCommitType: "chore",
	semanticCommitScope: "repo",

	// Longer than pnpm's minimumReleaseAge (1 day, strict), so lockfile updates never pick a version pnpm rejects.
	minimumReleaseAge: "3 days",
	internalChecksFilter: "strict",

	// Refresh transitive dependencies within their ranges; stale lockfile entries caused most audit findings.
	lockFileMaintenance: {
		enabled: true,
		schedule: ["before 6am on monday"],
	},

	vulnerabilityAlerts: {
		labels: ["security"],
		schedule: ["at any time"],
		// pnpm still rejects anything younger than 1 day.
		minimumReleaseAge: "1 day",
	},

	automergeStrategy: "squash",
	rangeStrategy: "bump",

	packageRules: [
		{
			description: "Website dependencies use the web scope.",
			matchFileNames: ["apps/web/**"],
			semanticCommitScope: "web",
		},
		{
			description: "Package dependencies use the package's scope; catalog updates in pnpm-workspace.yaml keep repo.",
			matchFileNames: ["packages/cli/**"],
			semanticCommitScope: "cli",
		},
		{
			matchFileNames: ["packages/stylelint-plugin/**"],
			semanticCommitScope: "stylelint",
		},
		{
			matchFileNames: ["packages/config/**"],
			semanticCommitScope: "config",
		},
		{
			matchFileNames: ["packages/core/**"],
			semanticCommitScope: "core",
		},
		{
			matchFileNames: ["packages/eslint-config/**"],
			semanticCommitScope: "eslint-config",
		},
		{
			description: "Auto-merge minor and patch updates once required checks pass.",
			matchUpdateTypes: ["minor", "patch", "pin", "pinDigest", "digest", "lockFileMaintenance"],
			automerge: true,
		},
		{
			description: "Astro pins its markdown pipeline and Shiki versions, so they move together and get reviewed.",
			matchPackageNames: ["astro", "@astrojs/**", "@shikijs/**", "shiki"],
			groupName: "astro",
			automerge: false,
		},
		{
			description: "Satori releases almost daily and its rendering changes between 0.x versions; update it deliberately from the dashboard and compare the OG images.",
			matchPackageNames: ["satori"],
			automerge: false,
			dependencyDashboardApproval: true,
		},
		{
			description: "Runtime dependencies of published packages get reviewed and keep their ranges for consumers.",
			matchFileNames: [
				"packages/cli/package.json",
				"packages/config/package.json",
				"packages/core/package.json",
				"packages/stylelint-plugin/package.json",
			],
			matchDepTypes: ["dependencies"],
			rangeStrategy: "update-lockfile",
			automerge: false,
		},
		{
			description: "Widen peer ranges instead of dropping support for older versions.",
			matchDepTypes: ["peerDependencies"],
			rangeStrategy: "widen",
			automerge: false,
		},
		{
			matchPackageNames: ["eslint", "@eslint/**", "typescript-eslint", "@typescript-eslint/**", "eslint-*"],
			groupName: "eslint",
		},
		{
			matchPackageNames: ["vitest", "@vitest/**"],
			groupName: "vitest",
		},
		{
			matchPackageNames: ["@changesets/**"],
			groupName: "changesets",
		},
		{
			matchPackageNames: ["@commitlint/**"],
			groupName: "commitlint",
		},
		{
			matchPackageNames: ["wrangler"],
			groupName: "wrangler",
		},
		{
			matchManagers: ["github-actions"],
			matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
			groupName: "github actions",
		},
		{
			description: "Raising engines minimums is a breaking change for consumers; change them deliberately.",
			matchDepTypes: ["engines"],
			enabled: false,
		},
		{
			description: "Hold TypeScript 7 until @astrojs/check and typescript-eslint support it.",
			matchPackageNames: ["typescript"],
			allowedVersions: "<7",
		},
		{
			description: "Stay on the Node 24 line (.nvmrc) until a deliberate runtime upgrade.",
			matchPackageNames: ["node"],
			allowedVersions: "<25",
		},
		{
			description: "Node types match the lowest Node version a package supports: 20.19 in the catalog (config, core, stylelint-plugin).",
			matchPackageNames: ["@types/node"],
			matchFileNames: ["pnpm-workspace.yaml"],
			allowedVersions: "<21",
		},
		{
			description: "The CLI supports Node 22.12 and newer.",
			matchPackageNames: ["@types/node"],
			matchFileNames: ["packages/cli/package.json"],
			allowedVersions: "<23",
		},
	],
}
