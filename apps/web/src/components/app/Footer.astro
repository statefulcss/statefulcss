---
interface Props {
	"data-slot"?: string;
}

const { "data-slot": dataSlot } = Astro.props;
---

<footer data-slot={dataSlot} data-component="app-footer">
	<div class="copyright">
		&copy; 2026 &ndash;{" "}
		<a href="https://humaninterface.studio" target="_blank" rel="noopener noreferrer">
			Human Interface Studio
		</a>
	</div>
	<nav aria-label="Legal links" class="legal-nav">
		<ul role="list">
			<li>
				<a href="/legal-notice/">Legal Notice</a>
			</li>
			<li>
				<a href="/privacy-policy/">Privacy Policy</a>
			</li>
		</ul>
	</nav>
</footer>

<style>
	[data-component="app-footer"] {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--t-space-4) var(--t-space-12);
		block-size: var(--t-app-footer-block-size);
		font-size: var(--t-font-size-xsmall);
		color: color-mix(in oklch, currentColor 65%, transparent);
	}

	.copyright {
		& a {
			text-decoration: none;
			text-wrap: nowrap;

			&:hover {
				color: var(--t-color-accent);
			}
		}
	}

	.legal-nav {
		display: flex;
		justify-content: flex-end;

		& > ul {
			display: flex;
			align-items: center;
			gap: var(--t-space-4);

			& > li {
				& > a {
					text-decoration: none;
					text-wrap: nowrap;

					&:hover {
						color: var(--t-color-accent);
					}
				}
			}
		}
	}
</style>
