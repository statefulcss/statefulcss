---
interface Props {
	"data-slot"?: string;
}

const { "data-slot": dataSlot } = Astro.props;
---

<footer data-slot={dataSlot} data-component="app-footer">
	<a href="https://humaninterface.studio" data-part="studio-logo">
		<span class="visually-hidden">Human Interface Studio</span>
	</a>
	<nav aria-label="Legal links" data-part="legal-nav">
		<ul role="list">
			<li>
				<a href="/legal-notice/">Legal Notice</a>
			</li>
			<li>
				<a href="/privacy-policy/">Privacy Policy</a>
			</li>
		</ul>
	</nav>
</footer>

<style>
	[data-component="app-footer"] {
		--s-block-size: auto;
		--s-padding-block: var(--t-space-9);
		--s-grid-template: "studio-logo" "legal-nav" / 1fr;
		--p-legal-nav-justify-self: start;

		display: grid;
		grid-template: var(--s-grid-template);
		align-items: center;
		gap: var(--t-space-6);
		block-size: var(--s-block-size);
		padding-block: var(--s-padding-block);
		font-size: var(--t-font-size-xsmall);
		/* background-color: light-dark(oklch(0.98 0 0), oklch(0.14 0 0)); */

		@media (width >= 54rem) {
			--s-grid-template: ". studio-logo legal-nav" / 1fr auto 1fr;
			--s-block-size: var(--t-app-footer-block-size);
			--s-padding-block: 0;
			--p-legal-nav-justify-self: end;
		}
	}

	@scope ([data-component="app-footer"]) to (:global([data-component])) {
		[data-part="studio-logo"] {
			--s-grid-column: auto;
			--s-background-color: light-dark(
				color-mix(in srgb, currentcolor, transparent 55%),
				color-mix(in srgb, currentcolor, transparent 25%)
			);

			grid-area: studio-logo;
			display: block;
			aspect-ratio: 7.5 / 1;
			block-size: 1rlh;
			mask: var(--t-app-studio-logomark) center / contain no-repeat;
			background-color: var(--s-background-color);
			transition: var(--t-transition-slow);
			transition-property: background-color;

			&:hover {
				--s-background-color: var(--t-color-brand-studio);
			}
		}
		[data-part="legal-nav"] {
			grid-area: legal-nav;
			justify-self: var(--p-legal-nav-justify-self);

			& > ul {
				display: flex;
				align-items: center;
				gap: var(--t-space-4);
			}

			& a {
				font-size: var(--t-font-size-2xsmall);
				text-decoration: none;
				text-wrap: nowrap;
				transition: var(--t-transition-slow);
				transition-property: color;
			}
		}
	}
</style>
