---
interface Props {
	"data-slot"?: string;
}

const { "data-slot": dataSlot } = Astro.props;
---

<header data-slot={dataSlot} data-component="app-header">
	<a href="/" data-part="brand">
		Stateful CSS
	</a>
	<nav aria-label="Primary" data-part="primary-nav">
		<ul role="list">
			<li>
				<a href="/docs/">Documentation</a>
			</li>
			<li>
				<a href="https://github.com/statefulcss/statefulcss" rel="noopener noreferrer" data-item="github">
					GitHub
				</a>
			</li>
		</ul>
	</nav>
</header>

<style>
	@layer components {
		[data-component="app-header"] {
			position: sticky;
			inset-block-start: 0;
			z-index: 100;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--t-space-4);
			block-size: var(--t-app-header-block-size);
			padding-block: var(--t-space-6);
		}

		@scope ([data-component="app-header"]) to (:global([data-component])) {
			[data-part="brand"] {
				--s-color: var(--t-color-foreground-base);

				text-decoration: none;
				display: flex;
				align-items: center;
				gap: var(--t-space-2);
				font-size: var(--t-font-size-large);
				font-weight: var(--t-font-weight-600);
				color: var(--s-color);

				&::before {
					content: "";
					display: block;
					mask-image: var(--t-app-logomark);
					mask-size: contain;
					mask-position: left center;
					mask-repeat: no-repeat;
					background-color: currentcolor;
					block-size: 1cap;
					margin-block-end: -0.1em;
					aspect-ratio: 8 / 7;
				}

				&:hover {
					--s-color: light-dark(currentcolor, var(--t-color-brand));
				}
			}

			[data-part="primary-nav"] {
				& > ul {
					display: flex;
					align-items: center;
					gap: var(--t-space-4);
					justify-content: flex-end;
					font-size: var(--t-font-size-small);
					font-weight: var(--t-font-weight-450);

					& > li {
						& > a {
							text-decoration: none;
							text-wrap: nowrap;
						}
					}
				}
			}
		}
	}
</style>
