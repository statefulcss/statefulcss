---
interface Props {
	"data-slot"?: string;
	title: string;
	summary?: string;
	draft?: boolean;
}

const { "data-slot": dataSlot, title, summary, draft = false } = Astro.props;
---

<header data-component="article-header" data-slot={dataSlot}>
	<h1 id="article-title" data-part="title">
		{title}
	</h1>
	{draft && <p data-part="draft">Draft</p>}
	{summary && <p data-part="summary">{summary}</p>}
	<slot name="details" />
</header>

<style>
	@layer components {
		[data-component="article-header"] {
			display: flex;
			flex-direction: column;
			gap: var(--t-space-1-5);
		}

		@scope ([data-component="article-header"]) to (:global([data-component])) {
			[data-part="title"] {
				font-size: var(--t-font-size-2xlarge);
			}

			[data-part="summary"] {
				font-weight: var(--t-font-weight-450);
				color: color-mix(in srgb, currentcolor, transparent 35%);
			}
		}
	}
</style>
