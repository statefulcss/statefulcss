---
import Prose from "@components/content/Prose.astro";
import Outline from "@components/docs/Outline.astro";
import PageNavigation from "@components/docs/PageNavigation.astro";
import { type SidebarItem } from "@utils/content";
import type { MarkdownHeading } from "astro";
import ArticleHeader from "./ArticleHeader.astro";

interface Props {
	"data-slot"?: string;
	title: string;
	summary: string;
	draft?: boolean;
	headings: MarkdownHeading[];
	pageNavigation?: {
		previous?: Pick<SidebarItem, "title" | "href">;
		next?: Pick<SidebarItem, "title" | "href">;
	};
}

const { "data-slot": dataSlot, title, summary, draft = false, headings, pageNavigation = {} } = Astro.props;
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const { previous, next } = pageNavigation;
---

<article data-component="docs-article" data-slot={dataSlot} aria-labelledby="docs-article-title">
	<ArticleHeader data-slot="header" title={title} summary={summary} draft={draft}>
		<slot name="details" slot="details" />
	</ArticleHeader>

	{contents.length > 0 && <Outline data-slot="outline" contents={contents} />}

	<Prose data-slot="content">
		<slot />
	</Prose>

	{(previous || next) && <PageNavigation data-slot="navigation" previous={previous} next={next} />}
</article>

<style>
	@layer components {
		/**
			 * Docs Article
			 * @component docs-article
			 * @queries --q-docs-outline
			 */
		[data-component="docs-article"] {
			--s-grid-template-areas: "header" "content" "navigation";

			display: grid;
			grid-template-columns: subgrid;
			grid-template-rows: auto auto 1fr;
			grid-template-areas: var(--s-grid-template-areas);
			row-gap: var(--t-space-12);
			padding-block-start: var(--t-space-9);
			margin-block-end: var(--t-space-12);

			@container style(--q-docs-outline: visible) {
				--s-grid-template-areas: "header outline" "content outline" "navigation outline";
			}

			& > :global([data-slot="header"]),
			& > :global([data-slot="content"]),
			& > :global([data-slot="navigation"]) {
				inline-size: 100%;
				max-inline-size: var(--t-app-content-max-size);
				margin-inline: auto;
			}

			& > :global([data-slot="header"]) {
				grid-area: header;
			}
			& > :global([data-slot="outline"]) {
				grid-area: outline;
				align-self: start;
				justify-self: end;
			}
			& > :global([data-slot="content"]) {
				grid-area: content;
			}
			& > :global([data-slot="navigation"]) {
				grid-area: navigation;
			}
		}
	}
</style>
