---
interface Props {
	"data-slot"?: string;
	contents: {
		depth: number;
		slug: string;
		text: string;
	}[];
}

const { contents, "data-slot": dataSlot } = Astro.props;
---

<nav data-component="docs-toc" data-slot={dataSlot} aria-labelledby="docs-toc-title">
	<span id="docs-toc-title" data-part="toc-title">
		On this page
	</span>
	<ul role="list" data-part="list">
		{contents.map((heading) => (
			<li data-depth={heading.depth}>
				<a href={`#${heading.slug}`}>{heading.text}</a>
			</li>
		))}
	</ul>
</nav>

<style>
	@layer components {
		[data-component="docs-toc"] {
			display: flex;
			flex-direction: column;
			gap: var(--t-space-3);

			position: sticky;
			inset-block-start: calc(var(--t-app-header-block-size) + var(--t-space-12));
			align-self: start;
			max-block-size: calc(100dvb - var(--t-app-header-block-size));
			overflow-y: auto;
			overscroll-behavior: contain;
			padding-inline-end: var(--t-space-9);
		}

		@scope ([data-component="docs-toc"]) to (:global([data-component])) {
			[data-part="toc-title"] {
				font-size: var(--t-font-size-2xsmall);
				color: color-mix(in srgb, currentcolor, transparent 30%);
			}
			[data-part="list"] {
				display: flex;
				flex-direction: column;
				gap: var(--t-space-1-5);
				list-style: none;
				padding: 0;
				margin: 0;
				line-height: var(--t-font-line-height-tight);

				& a {
					--s-color: color-mix(in srgb, currentcolor, transparent 15%);

					font-size: var(--t-font-size-xsmall);
					text-decoration: none;
					color: var(--s-color);
				}
			}
		}
	}
</style>
