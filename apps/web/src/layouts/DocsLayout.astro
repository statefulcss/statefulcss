---
import PageColumns from "@components/app/PageColumns.astro";
import Sidebar from "@components/docs/Sidebar.astro";
import type { JsonLdSchema } from "@config/site";
import Layout from "@layouts/Layout.astro";
import { type SidebarSection } from "@utils/content";

interface Props {
	title: string;
	summary: string;
	image: string;
	sidebar: SidebarSection[];
	canonical: string;
	schema: JsonLdSchema[];
}

const { title, summary, sidebar, canonical, image, schema } = Astro.props;
---

<Layout
	title={title}
	description={summary}
	canonical={canonical}
	type="article"
	image={image}
	schema={schema}
>
	<PageColumns>
		<Sidebar slot="sidebar" data-slot="sidebar" canonical={canonical} sidebar={sidebar} />
		<slot />
	</PageColumns>
</Layout>
