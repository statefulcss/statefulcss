---
import Footer from "@components/app/Footer.astro";
import Head from "@components/app/Head.astro";
import Header from "@components/app/Header.astro";
import type { JsonLdSchema } from "@config/site";

interface Props {
	title?: string;
	description?: string;
	canonical?: string | URL;
	robots?: string;
	author?: string;
	themeColor?: string;
	type?: "website" | "article";
	publishedTime?: string | Date;
	modifiedTime?: string | Date;
	schema?: JsonLdSchema | JsonLdSchema[];
	image?: string | URL;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
}

const {
	title,
	description,
	canonical,
	robots,
	author,
	themeColor,
	type,
	publishedTime,
	modifiedTime,
	schema,
	image,
	imageAlt,
	imageWidth,
	imageHeight,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-scheme="light" data-theme="base" transition:animate="none">
	<head>
		<Head
			title={title}
			description={description}
			canonical={canonical}
			robots={robots}
			author={author}
			themeColor={themeColor}
			type={type}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			schema={schema}
			image={image}
			imageAlt={imageAlt}
			imageWidth={imageWidth}
			imageHeight={imageHeight}
		/>
	</head>
	<body>
		<div data-component="app-container">
			<Header data-slot="app-header" />
			<div id="app-page" data-slot="app-page">
				<slot />
			</div>
			<Footer data-slot="app-footer" />
		</div>
	</body>
</html>

<style>
	@layer components {
		[data-component="app-container"] {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			min-height: 100svb;

			& > :global([data-slot]) {
				padding-inline: var(--t-app-page-gutter);
			}

			& > :global([data-slot="app-page"]) {
				flex: 1;
				display: grid;
				min-block-size: var(--t-app-page-block-size);
			}
		}
	}
</style>
