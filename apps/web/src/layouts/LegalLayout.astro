---
import Prose from "@components/content/Prose.astro";
import Layout from "@layouts/Layout.astro";

interface Props {
	frontmatter: {
		title: string;
		description: string;
	};
}

const { title, description } = Astro.props.frontmatter;
---

<Layout title={title} description={description}>
	<main id="main-content">
		<article class="legal">
			<Prose>
				<slot />
			</Prose>
		</article>
	</main>
</Layout>

<style>
	.legal {
		max-inline-size: 80ch;
		text-wrap: pretty;
	}
</style>
