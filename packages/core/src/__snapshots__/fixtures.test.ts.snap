part .field [data-part="input"]

part .field [data-part="label"]
  #4 own: .field [data-part="label"]

guard on .field: :disabled, [aria-disabled="true"], [data-loading], [inert] and 1 state through :has(); around #1

part input named in #1: has
part input named in #2: has
part input named in #3: has
part label named in #4: scope"
`;

