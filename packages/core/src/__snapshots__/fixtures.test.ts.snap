// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`whole components > button.css reads the same in every syntax 1`] = `
"component button (.button; name from its tag)
  scope (.button) to ([data-component])
  doc comment "Button"

root .button
  #0 own: .button
  #2 variant: .button[data-intent="danger"]
  #3 variant: .button[data-size="small"]
  #4 state interaction, guarded: .button:where(:not(:disabled, [aria-disabled="true"], [data-loading], [inert])):hover
  #5 state blocking: .button:disabled
  #6 state blocking: .button[aria-disabled="true"]
  #7 state blocking: .button[data-loading]
  --_background-color: private, changing, read by .button
  --_background-color-hover: private, changing, read by .button
  --s-background-color: state, changing, read by .button
  --s-opacity: state, changing, read by .button
  --p-icon-inline-size: part, changing, for .button [data-part="icon"], read by .button [data-part="icon"]

slot .button [data-slot="badge"]
  #1 own, reached from the root block: .button > [data-slot="badge"]

part .button [data-part="icon"]
  #8 own: .button [data-part="icon"]

guard on .button: :disabled, [aria-disabled="true"], [data-loading], [inert]; around #4

part icon named in #8: scope"
`;

