exports[`whole components > field.css reads the same in every syntax 1`] = `
"component field (.field; name from its class)
  scope (.field) to ([data-component])

root .field
  #0 own: .field
  #1 state interaction, guarded: .field:where(:not(:disabled, [aria-disabled="true"], [data-loading], [inert], :has(:where([data-part="input"]):disabled))):hover
  #2 state semantic: .field:has(:where([data-part="input"])[aria-invalid="true"])
  #3 state blocking: .field:has(:where([data-part="input"]):disabled)
  --p-label-color: part, changing, for .field [data-part="label"], read by .field [data-part="label"]
  --s-opacity: state, changing, read by .field
