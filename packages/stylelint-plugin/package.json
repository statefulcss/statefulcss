{
	"name": "@statefulcss/stylelint-plugin",
	"version": "0.0.4",
	"type": "module",
	"license": "MIT",
	"description": "Stylelint plugin for Stateful CSS",
	"author": {
		"name": "Ömer Balyalı",
		"email": "git@omerbalyali.com",
		"url": "https://omerbalyali.com"
	},
	"homepage": "https://statefulcss.com",
	"keywords": [
		"statefulcss",
		"stateful-css",
		"css",
		"stylelint",
		"stylelint-plugin"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/statefulcss/statefulcss.git",
		"directory": "packages/stylelint-plugin"
	},
	"bugs": {
		"url": "https://github.com/statefulcss/statefulcss/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./recommended": {
			"types": "./dist/configs/recommended.d.ts",
			"default": "./dist/configs/recommended.js"
		},
		"./compatible": {
			"types": "./dist/configs/compatible.d.ts",
			"default": "./dist/configs/compatible.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint --max-warnings 0",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@statefulcss/config": "workspace:*",
		"@statefulcss/core": "workspace:*"
	},
	"peerDependencies": {
		"stylelint": "^17.0.0"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"eslint": "catalog:",
		"stylelint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
